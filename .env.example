# Copy this file to .env and fill in your values:
#   cp .env.example .env
# .env is ignored by Git. Never commit real keys.

# Which configuration to use: development (default), production, or testing.
APP_ENV=development

# YouTube Data API v3 key, used by "Import YouTube" and "Sync Now".
# Create one at https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=add_your_api_key_here

# Signs session cookies and CSRF tokens. Required when APP_ENV=production.
# Optional in development (a random key is generated on each start).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# Production only. Leave unset (true) behind HTTPS. Set to false only
# when serving over plain HTTP, such as a local container.
# SESSION_COOKIE_SECURE=true

# Optional. Defaults to a SQLite file at instance/tracker.db.
# Other databases are untested. PostgreSQL would also need a driver such as
# psycopg: postgresql://user:password@localhost:5432/social_analytics
# DATABASE_URL=sqlite:///tracker.db
